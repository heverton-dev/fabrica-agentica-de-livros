#!/bin/sh
# R16 (CLAUDE.md): nunca commitar suite vermelha - gate mecanico, nao so promessa.
# Fonte versionada: scripts/hooks/pre-commit (copiado para .git/hooks/pre-commit
# por scripts/setup-links.ps1|.sh, pois .git/hooks nao aceita link em todo SO).

# === GATE DE SEGREDOS (Item E — 2026-08-21) ===
# Bloqueia commit automático se o diff staged contiver padrão de segredo.
# Padrões: chaves OpenAI (sk-*), AWS (AKIA*), PEM privada, token GitHub (ghp_*), Slack (xox*).
# Allowlist: livros técnicos usam exemplos didáticos de detecção de segredos
# (ex.: cap. de segurança com "sk-ant-..."/"sk-omniroute-abc123def456" e
# placeholders "sk-ant-xxxx..."). Essas sequências são claramente fictícias
# (algarismos sequenciais / x's) e nunca são credenciais reais. A exceção
# "sk-management-framework" evita falso positivo de substring em URLs
# (ex.: ai-risk-management-framework).

ALLOWLIST_DIDATICO='sk-ant-1234567890abcdef1234567890|sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx|sk-omniroute-abc123def456|sk-management-framework'

PADROES_SEGREDO=(
    'sk-[a-zA-Z0-9_-]{20,}'
    'AKIA[0-9A-Z]{16}'
    '-----BEGIN [A-Z ]*PRIVATE KEY'
    'ghp_[a-zA-Z0-9]{36}'
    'xox[baprs]-[0-9a-zA-Z-]+'
)

for padrao in "${PADROES_SEGREDO[@]}"; do
    if git diff --cached | grep -E -- "$padrao" | grep -vE "$ALLOWLIST_DIDATICO" > /dev/null 2>&1; then
        echo "[BLOQUEADO] possível segredo no diff staged"
        echo ""
        echo "Padrão detectado: $padrao"
        git diff --cached | grep -n -E -- "$padrao" | grep -vE "$ALLOWLIST_DIDATICO" | head -5
        echo ""
        echo "Se é falso positivo, revise manualmente ou use 'git commit --no-verify' (com cuidado)."
        exit 1
    fi
done

# PONTO 4: Validação de estrutura HUB POR COLEÇÃO (V5) — endurecimento 2026-08
# Bloqueia commit se há mudanças em output/ e estrutura HUB é inválida
if git diff --cached --name-only | grep -q '^output/'; then
  echo "[pre-commit] Validando estrutura HUB POR COLECAO..."
  HOOK_ROOT=$(git rev-parse --show-toplevel)
  python -c "
import sys
from pathlib import Path
import subprocess
root = subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], text=True).strip()
sys.path.insert(0, str(Path(root) / 'scripts'))
import tipos_obra as TO

dir_output = Path(root) / 'output'
raizes_planas = {TO.raiz_output(t) for t in TO.tipos_raiz()}
raizes_planas.discard('distribuicao')

for tipo in raizes_planas:
    raiz = dir_output / tipo
    if raiz.exists():
        try:
            for obra in raiz.iterdir():
                if obra.is_dir() and not obra.name.startswith('_'):
                    print(f'ERRO: Raiz plana detectada: {tipo}/{obra.name}')
                    print(f'      Regra V5: use output/<obra>/{tipo}/<material>')
                    sys.exit(1)
        except OSError:
            pass
print('[OK] Estrutura HUB validada')
" || exit 1
fi

python -m pytest -q
if [ $? -ne 0 ]; then
  echo "[BLOQUEADO] suite de testes vermelha - corrija a causa antes de comitar (R16)"
  exit 1
fi

# Installed by code-review-graph. Remove this file to disable pre-commit graph checks.
# Regra 11: o painel do code-review-graph imprime unicode e quebra no console
# cp1252 (UnicodeEncodeError). Forca UTF-8 nas chamadas — nao depende do terminal.
if command -v code-review-graph >/dev/null 2>&1; then
    PYTHONIOENCODING=utf-8 PYTHONUTF8=1 code-review-graph update || true
    PYTHONIOENCODING=utf-8 PYTHONUTF8=1 code-review-graph detect-changes --brief || true
fi
