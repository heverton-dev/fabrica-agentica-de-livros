# Dependências MCP
.claude/mcp-servers/deps/

# Output (gerado pela fábrica)
#output/

# Junctions de acesso neutro (duplicam .claude/)
agentic/

# .env (API keys etc)
.env
.env.local
.env.*.local

# Config local
.skill-manager-config.json

# Bytecode Python (scripts da esteira)
__pycache__/
*.pyc

# Banco de estado da esteira (runtime, não versionar)
data/estado_fabrica.db

# Scripts legado (one-offs, movidos de scripts/)
scripts/_legado/

# Sistema
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Logs
*.log
logs/
.agents/

# Hooks do OpenCode vivem em .opencode/plugins/ (fonte); espelho .claude/plugins/ e ignorado
.claude/plugins/

# Junctions de acesso .opencode/ (espelham .claude/; plugins/ e versionado)
.opencode/agents/
.opencode/commands/
.opencode/skills/
.opencode/mcp-servers/
.opencode/settings.json
.opencode/settings.local.json
.opencode/scheduled_tasks.lock

# Máquinas de vendas — dependências e artefatos de runtime
**/node_modules/
**/.next/
**/backend/data/
**/database/*.db
**/database/*.db-*

# Artefato acidental de redirect Windows
nul

# Relatórios de sessão são SEMPRE versionados (convenção V5.2)
!relatorios/
!relatorios/*.md
!relatorios/*.pdf
# Added by code-review-graph
.code-review-graph/


